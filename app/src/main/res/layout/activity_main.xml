<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <ImageView
            android:id="@+id/logoApp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="50dp"
            android:contentDescription="no"
            android:src="@drawable/ic_logo_app"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/titleApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:text="TRUCO UTFPR"
            android:textColor="#745B00"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/logoApp"
            app:layout_constraintStart_toEndOf="@id/logoApp"
            app:layout_constraintTop_toTopOf="@id/logoApp" />

        <TextView
            android:id="@+id/statusGame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="Game in Progress"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/titleApp" />


        <androidx.cardview.widget.CardView
            android:id="@+id/cvPlayerOne"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#F2F0F0"
            app:cardCornerRadius="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/statusGame">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constrainLayout1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvPlayerOne"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Player 1"
                    android:textColor="#745B00"
                    android:textSize="18dp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/ivEdit_1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/ivEdit_1"
                    app:layout_constraintVertical_bias="0.439" />

                <ImageView
                    android:id="@+id/ivEdit_1"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="14dp"
                    android:src="@drawable/ic_edit"
                    app:layout_constraintStart_toEndOf="@id/tvPlayerOne"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvPointOne"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="POINTS"
                    android:textSize="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvPlayerOne" />

                <TextView
                    android:id="@+id/tvPoints"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="00"
                    android:textSize="64dp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvPlayerOne" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvPoints">

                    <Button
                        android:id="@+id/btAddOne_1"
                        android:layout_width="60dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="16dp"
                        android:backgroundTint="#FFCC00"
                        android:padding="0dp"
                        android:text="+1"
                        android:textColor="#745B00"
                        app:cornerRadius="0dp" />

                    <Button
                        android:id="@+id/btAddThree_1"
                        android:layout_width="60dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:backgroundTint="#FFCC00"
                        android:padding="0dp"
                        android:text="+3"
                        android:textColor="#745B00"
                        app:cornerRadius="0dp" />

                    <Button
                        android:id="@+id/btAddSix_1"
                        android:layout_width="60dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:backgroundTint="#FFCC00"
                        android:padding="0dp"
                        android:text="+6"
                        android:textColor="#745B00"
                        app:cornerRadius="0dp" />

                    <Button
                        android:id="@+id/btAddNine_1"
                        android:layout_width="60dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:backgroundTint="#FFCC00"
                        android:padding="0dp"
                        android:text="+9"
                        android:textColor="#745B00"
                        app:cornerRadius="0dp" />

                    <Button
                        android:id="@+id/btAddTwelve_1"
                        android:layout_width="60dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:backgroundTint="#FFCC00"
                        android:padding="0dp"
                        android:text="+12"
                        android:textColor="#745B00"
                        app:cornerRadius="0dp" />

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>


        <androidx.cardview.widget.CardView
            android:id="@+id/cvPlayerTwo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#F2F0F0"
            app:cardCornerRadius="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cvPlayerOne">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constrainLayout2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvPlayerTwo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Player 1"
                    android:textColor="#745B00"
                    android:textSize="18dp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/ivEdit_2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/ivEdit_2"
                    app:layout_constraintVertical_bias="0.439" />

                <ImageView
                    android:id="@+id/ivEdit_2"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="14dp"
                    android:src="@drawable/ic_edit"
                    app:layout_constraintStart_toEndOf="@id/tvPlayerTwo"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvPoint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="POINTS"
                    android:textSize="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvPlayerTwo" />

                <TextView
                    android:id="@+id/tvPointsTwo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="00"
                    android:textSize="64dp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvPlayerTwo" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvPointsTwo">

                    <Button
                        android:id="@+id/btAddOne_2"
                        android:layout_width="60dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="16dp"
                        android:backgroundTint="#FFCC00"
                        android:padding="0dp"
                        android:text="+1"
                        android:textColor="#745B00"
                        app:cornerRadius="0dp" />

                    <Button
                        android:id="@+id/btAddThree_2"
                        android:layout_width="60dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:backgroundTint="#FFCC00"
                        android:padding="0dp"
                        android:text="+3"
                        android:textColor="#745B00"
                        app:cornerRadius="0dp" />

                    <Button
                        android:id="@+id/btAddSix_2"
                        android:layout_width="60dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:backgroundTint="#FFCC00"
                        android:padding="0dp"
                        android:text="+6"
                        android:textColor="#745B00"
                        app:cornerRadius="0dp" />

                    <Button
                        android:id="@+id/btAddNine_2"
                        android:layout_width="60dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:backgroundTint="#FFCC00"
                        android:padding="0dp"
                        android:text="+9"
                        android:textColor="#745B00"
                        app:cornerRadius="0dp" />

                    <Button
                        android:id="@+id/btAddTwelve_2"
                        android:layout_width="60dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:backgroundTint="#FFCC00"
                        android:padding="0dp"
                        android:text="+12"
                        android:textColor="#745B00"
                        app:cornerRadius="0dp" />

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btHistory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#FFFFFF"
            android:text="Scoring History"
            android:textColor="#939095"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cvPlayerTwo"
            app:strokeColor="#939095"
            app:strokeWidth="1dp" />

        <Button
            android:id="@+id/btClear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:backgroundTint="#FFFFFF"
            android:text="Clear Score History"
            android:textColor="#939095"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btHistory"
            app:strokeColor="#939095"
            app:strokeWidth="1dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</ScrollView>